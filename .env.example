# CareMerge configuration (spec §14). Copy to .env and change what you need.
# Every key is optional for local development. Secrets go only in .env.

# Shared
CAREMERGE_TIMEZONE=America/New_York

# Add-on (apps/addon)
CAREMERGE_PLAN_HORIZON_DAYS=60
CAREMERGE_DEFAULT_REMINDER_TIME=10:00
CAREMERGE_MIN_QUOTE_WORDS=3
CAREMERGE_VISITS_DIR=fixtures/visits
CAREMERGE_EXTRACTION=stub
CAREMERGE_STUB_EXTRACTIONS_DIR=fixtures/extractions
CAREMERGE_STORE=memory
CAREMERGE_ADDON_HOST=127.0.0.1
CAREMERGE_ADDON_PORT=8000
CAREMERGE_LOCAL_USER_ID=demo

# Simulator (apps/simulator)
CAREMERGE_SIMULATOR_PORT=8765
CAREMERGE_DEV_ORIGINS=["http://localhost:5173"]
CAREMERGE_ADDON_URL=http://127.0.0.1:8000/mcp
CAREMERGE_ADDON_TIMEOUT_S=10
CAREMERGE_ADDON_INTAKE_TIMEOUT_S=90
CAREMERGE_ORCHESTRATOR=keyword
