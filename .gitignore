# Stack is not chosen yet, so this covers the likely candidates:
# React Native / Vega, Android (Kotlin), Python, and AWS CDK/SAM.

# --- Secrets & local config (12-factor: config lives in the environment) ---
.env
.env.*
!.env.example
*.pem
*.p12
*.keystore
*.jks
credentials.json
token.json

# --- Personal data: Bee exports, Ring clips/snapshots, recordings ---
# Keep anything recorded from a real person here; it must never be committed.
data/private/

# --- Claude Code personal overrides ---
.claude/settings.local.json
CLAUDE.local.md

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
